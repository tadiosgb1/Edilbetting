# Server
PORT=3000

# The Odds API
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_REGIONS=eu
ENABLED_SPORTS=soccer_epl
DEFAULT_MARGIN_PCT=6

# Sandbox safety: keep false so server.js never calls the upstream API.
# Production: set true to run the initial sync and scheduled refresh jobs.
CRON_RUN=false

# Refresh schedules (node-cron)
CRON_SYNC_SPORTS=0 */6 * * *
CRON_SYNC_EVENTS=*/30 * * * *
CRON_SYNC_ODDS_FAR=0 */3 * * *
CRON_SYNC_ODDS_TODAY=*/10 * * * *
CRON_SYNC_ODDS_SOON=*/5 * * * *
CRON_SYNC_SCORES=*/5 * * * *

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edilbetting
DB_USER=root
DB_PASSWORD=

# Optional API docs
SWAGGER_ENABLED=false
